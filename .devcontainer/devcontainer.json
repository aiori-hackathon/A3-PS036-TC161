{
  "name": "CipherOps",
  // Plain Debian base, with Python added as a feature. The Microsoft language images ship a Yarn apt source whose
  // signing key Yarn has rotated, which makes the apt-get update of every later feature fail with NO_PUBKEY.
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12",
      "installTools": false
    },
    // Docker runs inside the codespace, so the compose files' bind mounts (results/, configs/) resolve as written.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  // Minimum for the offline harness, which pins itself to CPU core 2 (so at least 3 cores) and builds large images.
  // This is the 4-core / 16 GB / 32 GB machine, the largest one available on the free tier. The simulated lab runs
  // about 7 containers pinned to cores 2-5 and needs the 8-core / 32 GB / 64 GB machine, which is not free; select it
  // when creating the codespace (Codespaces never offers a machine below these minimums).
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "containerEnv": {
    "STREAMLIT_SERVER_HEADLESS": "true",
    // The Codespaces port proxy rewrites the origin; without these the dashboard's websocket is refused.
    "STREAMLIT_SERVER_ENABLE_CORS": "false",
    "STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION": "false"
  },
  "postCreateCommand": "pip install --user -r requirements-dashboard.txt",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "CipherOps dashboard",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker"],
      "settings": {
        "python.testing.pytestEnabled": true
      }
    }
  }
}
