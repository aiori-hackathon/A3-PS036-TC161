# Verisign IETF-126-Interim branches (aligned with draft-kaizer-dnsop-ml-dsa-mtl-dnssec-02):
# the EDNS option is gone and every MTL RRSIG is served as a full signature.
# Same MTL library commit as the main Cipherops benchmark.
# PRIMITIVE: FIPS 205 SLH-DSA (liboqs 0.16 SLH_DSA_PURE_SHA2_128S) in MTL 7cef019 and in the ldns signer, so MTL and
# plain SLH-DSA use the same library call (offline harness default). The Unbound at this commit still contains only the
# removed SPHINCS+ name and answers SERVFAIL for plain SLH-DSA, so the live lab uses draft06 for that comparison.
STACK=latest
OPENSSL_TAG=openssl-3.6.0
LIBOQS_TAG=0.16.0
MTL_REPO=https://github.com/verisign/MTL.git
MTL_COMMIT=7cef0191da55048111d252a567b7614672424ed3
LDNS_REPO=https://github.com/Verisign/mtl-mode-ldns.git
LDNS_COMMIT=1de55d90709ef37e5c5ba81e450761cea31c6fc7
NSD_REPO=https://github.com/verisign/mtl-mode-nsd.git
NSD_COMMIT=31153312a6551781a3668c8819c5dc0ba2ef6bd5
UNBOUND_REPO=https://github.com/Verisign/mtl-mode-unbound.git
UNBOUND_COMMIT=04eacb760af4fe0ead5dc72fa3a1f4542befceed

ADOPT_DRAFT=draft-kaizer-dnsop-ml-dsa-mtl-dnssec-02 (always-full wire) + ML-DSA-44 +/- MTL on same pins
ADOPT_ALGORITHMS=mtl,ml-dsa-mtl,ml-dsa,ecdsa,ed25519,rsa,mixed-mtl
ADOPT_NOTES=Always-full MTL; use Prepare Key scheme KSK+ZSK to re-check DS/ladder vs draft06 condensed. Plain slh-dsa may SERVFAIL on this Unbound.
