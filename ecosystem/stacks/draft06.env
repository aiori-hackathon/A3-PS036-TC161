# PRIMITIVE: every component (ldns signer, MTL 1.2.0, Unbound) calls liboqs 0.14's SPHINCS+-SHA2-128s-simple, the
# pre-standard form of SLH-DSA (same parameter set and sizes). liboqs 0.14's default build has no FIPS 205 names, so
# the offline harness (which needs SLH_DSA_PURE_SHA2_128S) reports NO-GO on this profile. Use it for the live lab.
# draft-fregly-dnsop-slh-dsa-mtl-dnssec-06 behaviour: condensed signatures by
# default, full signature (signed ladder) only when the resolver asks with the
# mtl-mode-full EDNS option (code 65050). Components built against MTL v1.2.0,
# which needs liboqs 0.14.0 (its Dockerfile_pqc_base): MTL v1.2.0 calls the
# SPHINCS+ names that later liboqs releases removed.
STACK=draft06
OPENSSL_TAG=openssl-3.6.0
LIBOQS_TAG=0.14.0
MTL_REPO=https://github.com/verisign/MTL.git
MTL_COMMIT=93b05ef73dab53b953cc4e262401a2ce9bc9e431
LDNS_REPO=https://github.com/Verisign/mtl-mode-ldns.git
LDNS_COMMIT=64906672ae0d80ae03933240daab27e19ceccf70
NSD_REPO=https://github.com/verisign/mtl-mode-nsd.git
NSD_COMMIT=09ebb4e551b5029f7ddf7e381b7bb8a966fa1320
UNBOUND_REPO=https://github.com/Verisign/mtl-mode-unbound.git
UNBOUND_COMMIT=fab43ad682301633fa119158ecd22924f042cb26
ADOPT_DRAFT=draft-kaizer-dnsop-ml-dsa-mtl-dnssec-03 (ML-DSA path); presentation also uses fregly-06 SLH+MTL
ADOPT_ALGORITHMS=ml-dsa-mtl,ml-dsa,mtl,slh-dsa,ecdsa
ADOPT_NOTES=Shipped images already keygen/sign/verify ML-DSA-44-MTL-SHAKE-128 (129) and ML_DSA_44 (245).
